<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{2d7c728b-ede9-47ae-8dbd-354027c84dfb}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    // Power model
    aFeeds     : ARRAY[1..GVL_Param.FEED_COUNT] OF FB_PowerFeed;
    aSimMeters : ARRAY[1..GVL_Param.FEED_COUNT] OF FB_PowerMeter_Sim;
    aBoxes     : ARRAY[1..GVL_Param.BOX_COUNT] OF FB_SatelliteController;
    aLoads     : ARRAY[1..GVL_Param.LOAD_COUNT] OF FB_GenericLoad;
    ipMeter    : I_PowerMeter;

    // Totals for the website's top-level keys
    fTotalPowerW   : LREAL;
    fTotalAmps     : LREAL;
    fEnergyTodayWh : LREAL;

    // Reporting
    fbClock     : FB_ShowClock;
    fbTelemetry : FB_Telemetry;

    // Persistent data
    bSavePersistent : BOOL;                    // set TRUE online to store GVL_Persist now
    fbSavePersist   : FB_WritePersistentData;

    i : INT;
    n : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Clock. On a new local day the energy counters start again
fbClock();
IF fbClock.bValid AND (fbClock.nLocalDay <> GVL_Persist.nEnergyDay) THEN
    FOR i := 1 TO GVL_Param.FEED_COUNT DO
        GVL_Persist.aEnergyWh[i] := 0.0;
    END_FOR
    GVL_Persist.nEnergyDay := fbClock.nLocalDay;
END_IF

// Feeds: read the meter, filter, cable loss, start a new load list
FOR i := 1 TO GVL_Param.FEED_COUNT DO
    ipMeter := aSimMeters[i];
    aFeeds[i](stCfg := GVL_Config.aFeeds[i], ipMeter := ipMeter, fEnergyWh := GVL_Persist.aEnergyWh[i]);
END_FOR

// Boxes and generic loads: update, then report to their feed
FOR i := 1 TO GVL_Param.BOX_COUNT DO
    aBoxes[i](stCfg := GVL_Config.aBoxes[i]);
    n := GVL_Config.aBoxes[i].nFeedId;
    IF (n >= 1) AND (n <= GVL_Param.FEED_COUNT) THEN
        aFeeds[n].AddLoad(ipLoad := aBoxes[i]);
    ELSE
        aBoxes[i].SetShare(fShareW := 0.0, bShareValid := FALSE);  // nFeedId names no feed: nothing to estimate from
    END_IF
END_FOR
FOR i := 1 TO GVL_Param.LOAD_COUNT DO
    aLoads[i](stCfg := GVL_Config.aLoads[i]);
    n := GVL_Config.aLoads[i].nFeedId;
    IF (n >= 1) AND (n <= GVL_Param.FEED_COUNT) THEN
        aFeeds[n].AddLoad(ipLoad := aLoads[i]);
    END_IF
END_FOR

// Feeds: split what is left between the boxes without a supply, and add up the totals
fTotalPowerW   := 0.0;
fTotalAmps     := 0.0;
fEnergyTodayWh := 0.0;
FOR i := 1 TO GVL_Param.FEED_COUNT DO
    aFeeds[i].Allocate();
    IF aFeeds[i].bValid THEN
        fTotalPowerW := fTotalPowerW + MAX(0.0, aFeeds[i].stMeas.fPowerW);
        fTotalAmps   := fTotalAmps + aFeeds[i].fAmps;
    END_IF
    fEnergyTodayWh := fEnergyTodayWh + GVL_Persist.aEnergyWh[i];
END_FOR

// Telemetry: hand over the sources, then let it publish
FOR i := 1 TO GVL_Param.FEED_COUNT DO
    fbTelemetry.AddSource(eSection := E_JsonSection.Feed, ipSource := aFeeds[i]);
END_FOR
FOR i := 1 TO GVL_Param.BOX_COUNT DO
    fbTelemetry.AddSource(eSection := E_JsonSection.Box, ipSource := aBoxes[i]);
END_FOR
FOR i := 1 TO GVL_Param.LOAD_COUNT DO
    fbTelemetry.AddSource(eSection := E_JsonSection.Load, ipSource := aLoads[i]);
END_FOR
fbTelemetry(stCfg := GVL_Config.stMqtt, sPassword := GVL_Persist.sMqttPassword, sTimestamp := fbClock.sUtcIso,
            bSimulated := GVL_Config.bSimulateMeters OR GVL_Config.bSimulateSupplies,
            fTotalPowerW := fTotalPowerW, fTotalAmps := fTotalAmps, fEnergyTodayWh := fEnergyTodayWh);

// Store GVL_Persist on request: set bSavePersistent to TRUE online, once
fbSavePersist(NETID := '', PORT := _AppInfo.AdsPort, START := bSavePersistent, TMOUT := T#5S);
bSavePersistent := FALSE;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>