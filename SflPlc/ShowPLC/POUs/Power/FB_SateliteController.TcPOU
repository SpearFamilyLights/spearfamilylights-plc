<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SateliteController" Id="{fd4bea5b-c411-438a-8000-f3f90d5fc734}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SateliteController IMPLEMENTS I_FeedLoad, I_JsonSource
VAR_INPUT
    stCfg : ST_BoxConfig;  // this box's row of GVL_Config.aBoxes
END_VAR
VAR_OUTPUT
    bValid    : BOOL;   // the values below can be used
    bMeasured : BOOL;   // TRUE: from the supply. FALSE: estimated from the feed
    fDcAmps   : LREAL;  // A DC, filtered
    fDcVolts  : LREAL;  // V DC
    fAcPowerW : LREAL;  // W on the AC side
END_VAR
VAR
    fbSupply : FB_EcPowerSupply;
    fEff     : LREAL := 0.95;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fEff := LIMIT(0.5, stCfg.fPsuEfficiency, 1.0);

IF stCfg.bHasEcPowerSupply THEN
    bMeasured := TRUE;
    fbSupply(bSimulate := GVL_Config.bSimulateSupplies);

    IF fbSupply.bOnline THEN
        IF bValid THEN
            fDcAmps := F_LowPass(fState := fDcAmps, fInput := fbSupply.fOutputAmps,
                                 fTimeS := GVL_Config.fFilterTimeS, fCycleS := F_CycleTimeS());
        ELSE
            fDcAmps := fbSupply.fOutputAmps;  // first valid sample: no filter run-in
        END_IF
        fDcVolts  := fbSupply.fOutputVolts;
        fAcPowerW := fDcVolts * fDcAmps / fEff;
        bValid    := TRUE;
    ELSE
        // Off the bus: counted as 0 W and reported as not valid.
        fDcAmps   := 0.0;
        fDcVolts  := 0.0;
        fAcPowerW := 0.0;
        bValid    := FALSE;
    END_IF
ELSE
    // No supply: SetShare() writes the outputs when the feed has done its split.
    bMeasured := FALSE;
END_IF]]></ST>
    </Implementation>
    <Method Name="GetDemand" Id="{f5bd97ef-6b3a-4a18-9fc2-a3a18bdf500d}">
      <Declaration><![CDATA[METHOD GetDemand : ST_LoadDemand
VAR
    stDemand : ST_LoadDemand;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stCfg.bHasEcPowerSupply THEN
    stDemand.eKind     := E_LoadKind.Measured;
    stDemand.fAcPowerW := fAcPowerW;
    stDemand.fWeight   := 0.0;
    stDemand.bValid    := bValid;
ELSE
    stDemand.eKind     := E_LoadKind.Estimated;
    stDemand.fAcPowerW := 0.0;
    stDemand.fWeight   := UDINT_TO_LREAL(stCfg.nPixelCount);
    stDemand.bValid    := TRUE;
END_IF
GetDemand := stDemand;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetShare" Id="{19e24c6f-0ed2-426d-bffb-736a7c11d6c1}">
      <Declaration><![CDATA[METHOD SetShare
VAR_INPUT
    fShareW     : LREAL;  // W on the AC side
    bShareValid : BOOL;   // FALSE: the feed has no valid measurement
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT stCfg.bHasEcPowerSupply THEN
    fAcPowerW := MAX(0.0, fShareW);
    fDcVolts  := stCfg.fNominalDcVolts;
    IF stCfg.fNominalDcVolts > 1.0 THEN
        fDcAmps := fAcPowerW * fEff / stCfg.fNominalDcVolts;
    ELSE
        fDcAmps := 0.0;
    END_IF
    bValid := bShareValid;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteJson" Id="{b943426d-e14b-4302-a995-308542171dec}">
      <Declaration><![CDATA[METHOD WriteJson
VAR_INPUT
    eSection : E_JsonSection;
END_VAR
VAR_IN_OUT
    fbJson : FB_JsonSaxWriter;
END_VAR
VAR
    sFeed : STRING(20);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eSection <> E_JsonSection.Box THEN
    RETURN;
END_IF

sFeed := F_FeedIdString(nFeedId := stCfg.nFeedId);

fbJson.AddKey('id');
fbJson.AddString(stCfg.sId);
fbJson.AddKey('name');
fbJson.AddString(stCfg.sControllerName);
fbJson.AddKey('feed');
fbJson.AddString(sFeed);
F_JsonInt(sKey := 'pixels', nValue := UDINT_TO_DINT(MIN(stCfg.nPixelCount, 2147483647)), fbJson := fbJson);
F_JsonNum(sKey := 'maxDcAmps', fValue := stCfg.fMaxDcCurrent, bValid := TRUE, nDecimals := 1, fbJson := fbJson);
fbJson.AddKey('src');
IF stCfg.bHasEcPowerSupply THEN
    fbJson.AddString('psu');
ELSE
    fbJson.AddString('est');
END_IF
fbJson.AddKey('ok');
fbJson.AddBool(bValid);
F_JsonNum(sKey := 'dcAmps', fValue := fDcAmps, bValid := bValid, nDecimals := 2, fbJson := fbJson);
F_JsonNum(sKey := 'dcVolts', fValue := fDcVolts, bValid := bValid AND stCfg.bHasEcPowerSupply, nDecimals := 1, fbJson := fbJson);
F_JsonNum(sKey := 'acW', fValue := fAcPowerW, bValid := bValid, nDecimals := 1, fbJson := fbJson);

fbJson.AddKey('psu');
IF stCfg.bHasEcPowerSupply THEN
    fbJson.StartObject();
    fbJson.AddKey('dcOk');
    fbJson.AddBool(fbSupply.bDcOk);
    fbJson.AddKey('warn');
    fbJson.AddBool(fbSupply.bWarning);
    fbJson.AddKey('err');
    fbJson.AddBool(fbSupply.bError);
    F_JsonNumSigned(sKey := 'tempC', fValue := fbSupply.fTempC, bValid := fbSupply.bTempValid, nDecimals := 0, fbJson := fbJson);
    F_JsonNum(sKey := 'inVolts', fValue := fbSupply.fInputVolts, bValid := fbSupply.bInputVoltsValid, nDecimals := 0, fbJson := fbJson);
    fbJson.EndObject();
ELSE
    fbJson.AddNull();
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>