<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_IpcDiagnostics" Id="{b66f03a7-b123-4a25-94cd-113fe7dae7f5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_IpcDiagnostics IMPLEMENTS I_JsonSource
VAR_INPUT
    bEnable : BOOL := TRUE;  // FALSE: leave the Device Manager alone
	sHostThermalPath : STRING(255) := '/sys/class/hwmon/hwmon2/temp2_input';  // Zynq FPD: the A53 cores. hwmon1 = rv3032 RTC (board), hwmon2 temp1 = LPD
END_VAR
VAR_OUTPUT
    // PLC task
    nCycleUs     : UDINT;    // configured cycle time
    nLastExecUs  : UDINT;    // execution time of the last cycle
    nExceedCount : UDINT;    // cycles that overran since the PLC started
    fUptimeS     : LREAL;    // PLC run time
    bRtCpuValid  : BOOL;
    fRtCpuPct    : LREAL;    // TwinCAT real-time share of the CPU

    // Controller, from the Device Manager
    bMdpReady    : BOOL;     // the Device Manager answered
    hrMdpError   : HRESULT;  // last error from registration or a read
    bCpuValid    : BOOL;
    fCpuPct      : LREAL;    // whole-controller CPU load
    bTempValid   : BOOL;
    fCpuTempC    : LREAL;
    bMemValid    : BOOL;
    fMemPct      : LREAL;    // RAM in use
    bDiskValid   : BOOL;
    fDiskPct     : LREAL;    // storage in use, largest volume

    // EtherCAT master
    bEcLinked    : BOOL;     // the three inputs below are linked
    bEcOk        : BOOL;
END_VAR
VAR
    // Optional links to the EtherCAT master (step 3)
    nEcDevState   AT %I* : UINT;  // Inputs > DevState. 0 = no fault
    nEcSlaveCount AT %I* : UINT;  // Inputs > SlaveCount: slaves found
    nEcCfgSlaves  AT %I* : UINT;  // InfoData > CfgSlaveCount: slaves configured

    nTaskIdx : DINT;

    // TwinCAT real-time share
    fbRtCpu  : TC_CpuUsage;
    tonRtCpu : TON;
    nRtStep  : INT;

    // Kernel temperature
    fbThermal  : FB_HostThermal;
    bMdpTemp   : BOOL;   // the Device Manager served CPU_Temp in the last round

    // Device Manager
    fbRegister : FB_IPCDiag_Register;
    fbRead     : FB_IPCDiag_ReadParameter;
    tonMdp     : TON;
    nMdpStep   : INT;
    nKey       : INT;
    aKeys      : ARRAY[1..KEY_COUNT] OF E_IPCDiag_ParameterKey := [
                     E_IPCDiag_ParameterKey.CPU_Usage,
                     E_IPCDiag_ParameterKey.CPU_Temp,
                     E_IPCDiag_ParameterKey.Memory_ProgramMemoryAllocated,
                     E_IPCDiag_ParameterKey.Memory_ProgramMemoryAvailable,
                     E_IPCDiag_ParameterKey.Disk_VolumeList_TotelSize,
                     E_IPCDiag_ParameterKey.Disk_VolumeList_FreeSpace];
    hr         : HRESULT;
    nValU16    : UINT;
    nValI16    : INT;
    nValU64    : ULINT;
    nMemTotal  : ULINT;
    bMemTotOk  : BOOL;
    aVolTotal  : ARRAY[1..MAX_VOLUMES] OF ULINT;
    nVolCount  : USINT;
    nFreeCount : USINT;
    nBest      : USINT;
    nBestSize  : ULINT;
    j          : USINT;
END_VAR
VAR CONSTANT
    KEY_COUNT   : INT := 6;
    MAX_VOLUMES : USINT := 8;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ---- PLC task ---------------------------------------------------------------
nTaskIdx := GETCURTASKINDEXEX();
IF (nTaskIdx >= 1) AND (nTaskIdx <= 20) THEN
    nCycleUs    := _TaskInfo[nTaskIdx].CycleTime / 10;     // 100 ns to microseconds
    nLastExecUs := _TaskInfo[nTaskIdx].LastExecTime / 10;
    IF _TaskInfo[nTaskIdx].CycleTimeExceeded THEN
        nExceedCount := nExceedCount + 1;
    END_IF
END_IF
fUptimeS := fUptimeS + F_CycleTimeS();

// ---- TwinCAT real-time share, every 5 s -------------------------------------------
CASE nRtStep OF
    0:
        tonRtCpu(IN := TRUE, PT := T#5S);
        IF tonRtCpu.Q THEN
            tonRtCpu(IN := FALSE);
            fbRtCpu(NETID := '', START := FALSE);
            fbRtCpu(NETID := '', START := TRUE, TMOUT := T#2S);
            nRtStep := 1;
        END_IF
    1:
        fbRtCpu(START := FALSE);
        IF NOT fbRtCpu.BUSY THEN
            bRtCpuValid := NOT fbRtCpu.ERR;
            IF bRtCpuValid THEN
                fRtCpuPct := UDINT_TO_LREAL(fbRtCpu.USAGE);
            END_IF
            nRtStep := 0;
        END_IF
ELSE
    nRtStep := 0;
END_CASE

// ---- Kernel temperature, every 10 s. The Device Manager on RT Linux has no CPU_Temp (V3) ---
fbThermal(bEnable := bEnable AND (LEN(sHostThermalPath) > 0), sPath := sHostThermalPath);

// ---- Device Manager: register once, then read one parameter after the other ----------
CASE nMdpStep OF
    0:  // the Device Manager needs time after boot
        tonMdp(IN := bEnable, PT := T#30S);
        IF tonMdp.Q THEN
            tonMdp(IN := FALSE);
            fbRegister(bExecute := FALSE);
            fbRegister(bExecute := TRUE);
            nMdpStep := 1;
        END_IF

    1:  // wait for the registration
        fbRegister(bExecute := FALSE);
        IF NOT fbRegister.bBusy THEN
            IF fbRegister.bError THEN
                hrMdpError := fbRegister.hrErrorCode;
                bMdpReady  := FALSE;
                nMdpStep   := 0;  // try again in 30 s
            ELSE
                bMdpReady := TRUE;
                nKey      := 1;
                nMdpStep  := 2;
            END_IF
        END_IF

    2:  // start one read
        fbRead(bExecute := FALSE, fbRegister := fbRegister);
        fbRead(bExecute := TRUE, eParameterKey := aKeys[nKey], fbRegister := fbRegister);
        nMdpStep := 3;

    3:  // wait for it, then take the value
        fbRead(bExecute := FALSE, fbRegister := fbRegister);
        IF NOT fbRead.bBusy THEN
            IF fbRead.bError THEN
                hrMdpError := fbRead.hrErrorCode;
            END_IF

            CASE nKey OF
                1:  // CPU load, UINT, %
                    bCpuValid := FALSE;
                    IF NOT fbRead.bError THEN
                        hr := fbRead.GetParameter(pBuffer := ADR(nValU16), nBufferSize := SIZEOF(nValU16));
                        IF SUCCEEDED(hr) THEN
                            fCpuPct   := LIMIT(0.0, UINT_TO_LREAL(nValU16), 100.0);
                            bCpuValid := TRUE;
                        END_IF
                    END_IF

                2:  // CPU temperature, INT, degrees C
                    bMdpTemp := FALSE;
                    IF fbRead.bError AND (nKey <> 2) THEN   // key 2 (CPU_Temp) has the kernel as fallback; its absence is not a faultN
                        hr := fbRead.GetParameter(pBuffer := ADR(nValI16), nBufferSize := SIZEOF(nValI16));
                        IF SUCCEEDED(hr) THEN
                            fCpuTempC  := INT_TO_LREAL(nValI16);
                            bMdpTemp := TRUE;
                        END_IF
                    END_IF

                3:  // RAM allocated, ULINT, bytes
                    bMemTotOk := FALSE;
                    IF NOT fbRead.bError THEN
                        hr := fbRead.GetParameter(pBuffer := ADR(nValU64), nBufferSize := SIZEOF(nValU64));
                        IF SUCCEEDED(hr) THEN
                            nMemTotal := nValU64;
                            bMemTotOk := nValU64 > 0;
                        END_IF
                    END_IF

                4:  // RAM available, ULINT, bytes
                    bMemValid := FALSE;
                    IF bMemTotOk AND NOT fbRead.bError THEN
                        hr := fbRead.GetParameter(pBuffer := ADR(nValU64), nBufferSize := SIZEOF(nValU64));
                        IF SUCCEEDED(hr) THEN
                            IF nValU64 <= nMemTotal THEN
                                fMemPct   := (1.0 - ULINT_TO_LREAL(nValU64) / ULINT_TO_LREAL(nMemTotal)) * 100.0;
                                bMemValid := TRUE;
                            END_IF
                        END_IF
                    END_IF

                5:  // total size of every volume, list of ULINT, bytes
                    nVolCount := 0;
                    IF NOT fbRead.bError THEN
                        nVolCount := MIN(fbRead.nReadParameterValues, MAX_VOLUMES);
                        FOR j := 1 TO nVolCount DO
                            hr := fbRead.GetParameterByIdx(pBuffer := ADR(nValU64), nBufferSize := SIZEOF(nValU64), nParameterIdx := j);
                            IF SUCCEEDED(hr) THEN
                                aVolTotal[j] := nValU64;
                            ELSE
                                aVolTotal[j] := 0;
                            END_IF
                        END_FOR
                    END_IF

                6:  // free space of every volume. The largest volume is taken as the system storage.
                    bDiskValid := FALSE;
                    IF (nVolCount > 0) AND NOT fbRead.bError THEN
                        nFreeCount := MIN(fbRead.nReadParameterValues, MAX_VOLUMES);
                        nBest     := 0;
                        nBestSize := 0;
                        FOR j := 1 TO nVolCount DO
                            IF aVolTotal[j] > nBestSize THEN
                                nBestSize := aVolTotal[j];
                                nBest     := j;
                            END_IF
                        END_FOR
                        IF (nBest >= 1) AND (nBest <= nFreeCount) THEN
                            hr := fbRead.GetParameterByIdx(pBuffer := ADR(nValU64), nBufferSize := SIZEOF(nValU64), nParameterIdx := nBest);
                            IF SUCCEEDED(hr) THEN
                                IF nValU64 <= nBestSize THEN
                                    fDiskPct   := (1.0 - ULINT_TO_LREAL(nValU64) / ULINT_TO_LREAL(nBestSize)) * 100.0;
                                    bDiskValid := TRUE;
                                END_IF
                            END_IF
                        END_IF
                    END_IF
            END_CASE

            IF nKey >= KEY_COUNT THEN
                nKey     := 1;
                nMdpStep := 4;
            ELSE
                nKey     := nKey + 1;
                nMdpStep := 2;
            END_IF
        END_IF

    4:  // pause between rounds
        tonMdp(IN := TRUE, PT := T#5S);
        IF tonMdp.Q THEN
            tonMdp(IN := FALSE);
            IF bEnable THEN
                nMdpStep := 2;
            END_IF
        END_IF
ELSE
    nMdpStep := 0;
END_CASE

// ---- Temperature: the Device Manager's CPU_Temp when it serves one, else the kernel's thermal zone ----
IF (NOT bMdpTemp) AND fbThermal.bValid THEN
    fCpuTempC := fbThermal.fTempC;
END_IF
bTempValid := bMdpTemp OR fbThermal.bValid;

// ---- EtherCAT master -------------------------------------------------------------------
bEcLinked := nEcCfgSlaves > 0;
bEcOk     := bEcLinked AND (nEcDevState = 0) AND (nEcSlaveCount = nEcCfgSlaves);]]></ST>
    </Implementation>
    <Method Name="WriteJson" Id="{3e4591d0-5396-4ddf-a31c-3829d401737c}">
      <Declaration><![CDATA[METHOD WriteJson
VAR_INPUT
    eSection : E_JsonSection;
END_VAR
VAR_IN_OUT
    fbJson : FB_JsonSaxWriter;
END_VAR
VAR
    fRt : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eSection <> E_JsonSection.Diag THEN
    RETURN;
END_IF

// The first six keys are the website's original diag schema. They are required numbers there, so unknown is sent as 0.
fRt := 0.0;
IF bRtCpuValid THEN
    fRt := LIMIT(0.0, fRtCpuPct, 100.0);
END_IF
fbJson.AddKey('plcState');
fbJson.AddString('Run');
F_JsonNum(sKey := 'cpuPct', fValue := fRt, bValid := TRUE, nDecimals := 0, fbJson := fbJson);
F_JsonInt(sKey := 'cycleUs',     nValue := UDINT_TO_DINT(MIN(nCycleUs, 2147483647)),     fbJson := fbJson);
F_JsonInt(sKey := 'lastExecUs',  nValue := UDINT_TO_DINT(MIN(nLastExecUs, 2147483647)),  fbJson := fbJson);
F_JsonInt(sKey := 'exceedCount', nValue := UDINT_TO_DINT(MIN(nExceedCount, 2147483647)), fbJson := fbJson);
F_JsonNum(sKey := 'uptimeSec', fValue := fUptimeS, bValid := TRUE, nDecimals := 0, fbJson := fbJson);

fbJson.AddKey('ipc');
fbJson.StartObject();
F_JsonNum(sKey := 'cpuPct', fValue := fCpuPct, bValid := bCpuValid, nDecimals := 0, fbJson := fbJson);
F_JsonNumSigned(sKey := 'cpuTempC', fValue := fCpuTempC, bValid := bTempValid, nDecimals := 0, fbJson := fbJson);
F_JsonNum(sKey := 'memPct', fValue := fMemPct, bValid := bMemValid, nDecimals := 1, fbJson := fbJson);
F_JsonNum(sKey := 'diskPct', fValue := fDiskPct, bValid := bDiskValid, nDecimals := 1, fbJson := fbJson);
fbJson.EndObject();

fbJson.AddKey('ecat');
IF bEcLinked THEN
    fbJson.StartObject();
    fbJson.AddKey('ok');
    fbJson.AddBool(bEcOk);
    F_JsonInt(sKey := 'slaves',    nValue := UINT_TO_DINT(nEcSlaveCount), fbJson := fbJson);
    F_JsonInt(sKey := 'slavesCfg', nValue := UINT_TO_DINT(nEcCfgSlaves),  fbJson := fbJson);
    fbJson.EndObject();
ELSE
    fbJson.AddNull();
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>