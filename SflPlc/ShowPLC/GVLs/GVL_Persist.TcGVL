  <GVL Name="GVL_Persist" Id="{37ce5e80-ae4b-490d-b27a-ae2eb12b868e}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL PERSISTENT
    sMqttPassword : STRING(63);                                  // empty = telemetry stays offline
